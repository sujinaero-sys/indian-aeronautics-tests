  function confirmSubmit() {

    const counts = summariseCounts(state.questions);
    const total = state.questions.length;

    showModal(
      '<h3>Submit test?</h3>' +
      '<table class="exam-result-table">' +
      '<tr><td>Answered</td><td>' + (counts.answered + counts.answeredMarked) + '</td></tr>' +
      '<tr><td>Not answered</td><td>' + counts.notAnswered + '</td></tr>' +
      '<tr><td>Marked for review (not answered)</td><td>' + counts.marked + '</td></tr>' +
      '<tr><td>Not visited</td><td>' + counts.notVisited + '</td></tr>' +
      '<tr><td>Total questions</td><td>' + total + '</td></tr>' +
      '</table>' +
      '<div class="exam-modal-actions">' +
      '  <button type="button" class="exam-btn" id="modal-cancel">Continue Test</button>' +
      '  <button type="button" class="exam-btn exam-btn-primary" id="modal-submit">Submit</button>' +
      '</div>'
    );

    document.getElementById("modal-cancel").addEventListener("click", hideModal);
    document.getElementById("modal-submit").addEventListener("click", function () {
      hideModal();
      submitTest(false);
    });

  }

  function submitTest(autoSubmitted) {

    if (state.submitted) return;
    state.submitted = true;

    if (state.timerHandle) clearInterval(state.timerHandle);

    const sectionScores = {
      ga: { correct: 0, total: 0 },
      eng: { correct: 0, total: 0 },
      aero: { correct: 0, total: 0 }
    };

    let score = 0;
    let totalMarks = 0;

    const questionLog = state.questions.map(function (q) {

      const bucket = sectionScores[q.section] || sectionScores.aero;
      bucket.total++;
      totalMarks += q.marks;

      const studentAnswer = state.responses[q.qno];
      const graded = gradeQuestion(q, studentAnswer);

      if (graded.isCorrect) {
        score += q.marks;
        bucket.correct++;
      } else if (graded.attempted && graded.negMarksApplied) {
        score -= q.negMarks || 0;
      }

      return {
        question: q.question,
        options: q.options || [],
        studentAnswer: studentAnswer,
        correctAnswer: q.answer,
        isCorrect: graded.isCorrect,
      attempted: graded.attempted,
      explanation: q.explanation || ""};

    });

    score = Math.round(score * 100) / 100;
    const percentage = totalMarks
      ? Math.round((score / totalMarks) * 10000) / 100
      : 0;

    // --------------------------------------------------------
    // Explicit result counters required by the GATE backend
    // --------------------------------------------------------
    let attempted = 0;
    let correct = 0;
    let wrong = 0;
    let unanswered = 0;

    questionLog.forEach(function (item) {
      if (item && item.isCorrect) {
        correct++;
        attempted++;
      } else if (item && item.attempted) {
        attempted++;
        wrong++;
      } else {
        unanswered++;
      }
    });

    const payload = {
      studentId: session.id,
      studentName: session.name,
      email: session.email,
      testId: entry.id,
      paper: entry.id,
      paperTitle: state.meta.title || (entry.label + " â€” Mock " + entry.num),
      score: score,
      totalQuestions: state.questions.length,
      percentage: percentage,
      attempted: attempted,
      correct: correct,
      wrong: wrong,
      unanswered: unanswered,
      sectionScores: sectionScores,
      autoSubmitted: !!autoSubmitted,
      attemptToken: state.attemptToken,
      startedAt: state.startedAt,
      submittedAt: new Date().toISOString(),
      questions: questionLog
    };

    // text/plain avoids a CORS preflight the Apps Script web app
    // cannot answer (no doOptions handler).
    fetch(IA_AUTH_URL, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify(payload)
    }).catch(function (err) {
      console.error("Result backup failed:", err);
    }).finally(function () {
      iaMarkCredentialFinished(session.id);
      renderResultScreen(payload);
    });

  }

  /**
   * Official GATE marking:
   *  - MCQ: negative marking (1/3 of the question's marks for
   *    1-mark Qs, 2/3 for 2-mark Qs) on a wrong pick; 0 if
   *    unattempted.
   *  - MSQ: full marks only if the response set exactly equals
   *    the correct set; otherwise 0. No negative marking.
   *  - NAT: full marks if within tolerance of the published
   *    answer. No negative marking.
   */
  function gradeQuestion(q, studentAnswer) {

    if (!hasResponse(q)) {
      return { attempted: false, isCorrect: false, negMarksApplied: false };
    }

    let isCorrect = false;

    if (q.type === "mcq") {

      isCorrect = studentAnswer === q.answer;

    } else if (q.type === "msq") {

      const given = Array.isArray(studentAnswer) ? studentAnswer.slice().sort() : [];
      const correct = Array.isArray(q.answer) ? q.answer.slice().sort() : [];

      isCorrect =
        given.length === correct.length &&
        given.every(function (v, i) { return v === correct[i]; });

    } else if (q.type === "nat") {

      const given = parseFloat(studentAnswer);
      const target = Number(q.answer);
      const tol = q.tolerance !== undefined ? Number(q.tolerance) : 0.01;

      isCorrect = !isNaN(given) && Math.abs(given - target) <= tol;

    }

    return {
      attempted: true,
      isCorrect: isCorrect,
      negMarksApplied: !isCorrect && q.type === "mcq"
    };

  }


