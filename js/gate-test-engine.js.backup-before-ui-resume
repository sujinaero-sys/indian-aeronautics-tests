  /* ---------------------------------------------------
     14. VIRTUAL CALCULATOR
     ---------------------------------------------------
     GATE does not permit physical calculators; a basic
     on-screen scientific calculator is provided instead.
     Expression is built entirely from button clicks (the
     display is read-only), so the characters fed to the
     evaluator are always from a known-safe set.
     --------------------------------------------------- */

  let calcExpr = "";
  let calcDisplayExpr = "";

  function buildCalculator() {

    const box = document.getElementById("exam-calculator");

    const buttons = [
      ["C", "clear"], ["âŒ«", "back"], ["(", "("], [")", ")"], ["Ã·", "/"],
      ["7", "7"], ["8", "8"], ["9", "9"], ["Ã—", "*"], ["âˆš", "sqrt"],
      ["4", "4"], ["5", "5"], ["6", "6"], ["âˆ’", "-"], ["xÂ²", "sq"],
      ["1", "1"], ["2", "2"], ["3", "3"], ["+", "+"], ["1/x", "inv"],
      ["0", "0"], [".", "."], ["Ï€", "pi"], ["e", "e"], ["=", "eq"],
      ["sin", "sin"], ["cos", "cos"], ["tan", "tan"], ["log", "log"], ["ln", "ln"]
    ];

    box.innerHTML =
      '<div class="exam-calc-display" id="exam-calc-display">0</div>' +
      '<div class="exam-calc-grid">' +
      buttons.map(function (b) {
        return '<button type="button" class="exam-calc-btn" data-op="' + b[1] + '">' + b[0] + '</button>';
      }).join("") +
      '</div>';

    box.querySelectorAll(".exam-calc-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        calcPress(btn.dataset.op);
      });
    });

  }

  function toggleCalculator() {
    const box = document.getElementById("exam-calculator");
    box.hidden = !box.hidden;
  }

  function calcPress(op) {

    const display = document.getElementById("exam-calc-display");

    if (op === "clear") {
      calcExpr = "";
      calcDisplayExpr = "";
    } else if (op === "back") {
      calcExpr = calcExpr.slice(0, -1);
      calcDisplayExpr = calcDisplayExpr.slice(0, -1);
    } else if (op === "eq") {

      try {
        // calcExpr is built exclusively from the whitelisted button
        // set above, never from free text input.
        const value = iaGateSafeCalculate(calcExpr);
        calcExpr = String(Math.round(value * 1e10) / 1e10);
        calcDisplayExpr = calcExpr;
      } catch (e) {
        calcExpr = "";
        calcDisplayExpr = "Error";
      }

    } else if (op === "sqrt") {
      calcExpr += "Math.sqrt(";
      calcDisplayExpr += "âˆš(";
    } else if (op === "sq") {
      calcExpr += "**2";
      calcDisplayExpr += "Â²";
    } else if (op === "inv") {
      calcExpr = "1/(" + calcExpr + ")";
      calcDisplayExpr = "1/(" + calcDisplayExpr + ")";
    } else if (op === "pi") {
      calcExpr += "Math.PI";
      calcDisplayExpr += "Ï€";
    } else if (op === "e") {
      calcExpr += "Math.E";
      calcDisplayExpr += "e";
    } else if (["sin", "cos", "tan", "log", "ln"].indexOf(op) !== -1) {

      const fnMap = { sin: "Math.sin", cos: "Math.cos", tan: "Math.tan", log: "Math.log10", ln: "Math.log" };
      calcExpr += fnMap[op] + "(";
      calcDisplayExpr += op + "(";

    } else {
      calcExpr += op;
      calcDisplayExpr += op === "*" ? "Ã—" : (op === "/" ? "Ã·" : op);
    }

    display.textContent = calcDisplayExpr || "0";

  }


